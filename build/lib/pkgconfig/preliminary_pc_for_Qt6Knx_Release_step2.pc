prefix=/usr/local
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/libexec
libdir=${prefix}/lib
includedir=${prefix}/include

 
Name: Qt6 Knx
Description: Qt Knx module
Version: 6.8.2
Libs: -L${libdir} -lQt6Knx  
Cflags: -I${includedir}/QtKnx -I${includedir} -DQT_KNX_LIB
Requires: Qt6Core Qt6Network
