prefix=/usr/local
exec_prefix=${prefix}
bindir=${prefix}/bin
libexecdir=${prefix}/libexec
libdir=${prefix}/lib
includedir=${prefix}/include
$<$<BOOL:>:mkspecsdir=${prefix}/lib/mkspecs>
$<1: >
Name: Qt6 Knx
Description: Qt Knx module
Version: 6.8.2
Libs: $<$<NOT:$<STREQUAL:$<TARGET_PROPERTY:Qt6::Knx,TYPE>,INTERFACE_LIBRARY>>:-L${libdir} -lQt6Knx> $<$<BOOL:loose_link_options-NOTFOUND>:$<JOIN:$<REMOVE_DUPLICATES:loose_link_options-NOTFOUND>, >> $<JOIN:$<REMOVE_DUPLICATES:>, >
Cflags: $<$<BOOL:${includedir}/QtKnx;${includedir}>:-I$<JOIN:$<REMOVE_DUPLICATES:${includedir}/QtKnx;${includedir}>, -I>> $<$<BOOL:QT_KNX_LIB>:-D$<JOIN:$<REMOVE_DUPLICATES:QT_KNX_LIB>, -D>>
Requires: $<JOIN:$<REMOVE_DUPLICATES:Qt6Core;Qt6Network>, >
